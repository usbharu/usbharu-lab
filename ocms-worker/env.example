# Copy to /opt/ocms-worker/.env on VM110. MEDIA_DB_PASSWORD and INTERNAL_TOKEN
# come from /etc/komodo/stacks/management/ocms.env on ocms-pve3; HF_TOKEN comes
# from the Komodo variable of the same name. Never commit the real values.
MEDIA_DB_PASSWORD=REPLACE_WITH_MEDIA_DB_PASSWORD
INTERNAL_TOKEN=REPLACE_WITH_INTERNAL_TOKEN
HF_TOKEN=REPLACE_WITH_HF_TOKEN
