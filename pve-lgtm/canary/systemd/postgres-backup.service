[Unit]
Description=Daily verified PostgreSQL backup for OCMS
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=OTLP_ENDPOINT=http://192.168.1.240:4318
ExecStart=/usr/bin/python3 /usr/local/lib/lgtm-canary/postgres_backup.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
