{
  "id": null,
  "uid": "usbharulab-ocms",
  "title": "usbharu-lab · OCMS",
  "tags": [
    "usbharu-lab",
    "ocms"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Ubuntu / Docker",
      "type": "link",
      "url": "/d/usbharulab-infra",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "OCMS",
      "type": "link",
      "url": "/d/usbharulab-ocms",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "refresh": 1
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "bff,catalog,transfer,search,worker,embedding-runtime,recommendation-engine",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "worker",
        "label": "Worker",
        "type": "custom",
        "query": "All : .*, VPS (ocms-ubuntu) : ocms-ubuntu, VM110 (ocms-worker-vm110) : ocms-worker-vm110, PVE3 (ocms-pve3) : ocms-pve3",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "VPS (ocms-ubuntu)",
            "value": "ocms-ubuntu"
          },
          {
            "selected": false,
            "text": "VM110 (ocms-worker-vm110)",
            "value": "ocms-worker-vm110"
          },
          {
            "selected": false,
            "text": "PVE3 (ocms-pve3)",
            "value": "ocms-pve3"
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTPリクエスト / 秒",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_request_duration_count{lab_host=\"ocms-ubuntu\",job=~\"usbharu-lab/($service)\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "HTTP 5xx率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "リクエストのない期間はデータなしと表示します。",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_request_duration_count{lab_host=\"ocms-ubuntu\",job=~\"usbharu-lab/($service)\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_request_duration_count{lab_host=\"ocms-ubuntu\",job=~\"usbharu-lab/($service)\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "完了Job（選択期間）",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Loki の media.job_completed ログを選択期間で集計。collector 修正前の pve3/vm110 ラベル衝突を避けるため、ログベースにしている。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_completed\" [$__range]))",
          "legendFormat": "completed",
          "range": true,
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "失敗Job（選択期間）",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "description": "Loki の media.job_failed（status=failed）ログを選択期間で集計。retry は含まない。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_failed\" | status=\"failed\" [$__range]))",
          "legendFormat": "failed",
          "range": true,
          "instant": true,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,job) (rate(http_server_request_duration_bucket{lab_host=\"ocms-ubuntu\",job=~\"usbharu-lab/($service)\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "サービス別リクエスト",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job,http_response_status_code) (rate(http_server_request_duration_count{lab_host=\"ocms-ubuntu\",job=~\"usbharu-lab/($service)\"}[$__rate_interval]))",
          "legendFormat": "{{job}} · {{http_response_status_code}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "処理時間の平均",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "各処理の平均時間。実行中Jobの経過時間やキュー待ち時間は含みません。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(job) (rate(media_transcode_duration_sum{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval])) / sum by(job) (rate(media_transcode_duration_count{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]))",
          "legendFormat": "transcode · {{job}}"
        },
        {
          "refId": "B",
          "expr": "sum by(job) (rate(media_embedding_duration_sum{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval])) / sum by(job) (rate(media_embedding_duration_count{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]))",
          "legendFormat": "embedding · {{job}}"
        },
        {
          "refId": "C",
          "expr": "sum by(job) (rate(media_search_duration_sum{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval])) / sum by(job) (rate(media_search_duration_count{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]))",
          "legendFormat": "search · {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Job完了・失敗の推移",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "description": "Loki ログのレート。完了は job_type 別、失敗・retry は status と error_code 別。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job_type) (rate({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_completed\" [$__rate_interval]))",
          "legendFormat": "{{job_type}} · completed",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (status, error_code) (rate({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_failed\" [$__rate_interval]))",
          "legendFormat": "{{status}} · {{error_code}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "転送・暗号処理",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(rate(media_upload_bytes{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]), \"metric\", \"upload\", \"\", \"\") or label_replace(rate(media_download_bytes{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]), \"metric\", \"download\", \"\", \"\") or label_replace(rate(media_crypto_bytes{lab_host=~\"ocms-ubuntu|ocms-worker-vm110\"}[$__rate_interval]), \"metric\", \"crypto\", \"\", \"\")",
          "legendFormat": "{{metric}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "OCMSコンテナCPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(compose_service) (rate(container_cpu_usage_seconds_total{lab_host=\"ocms-ubuntu\",compose_project=\"ocms\"}[$__rate_interval]))",
          "legendFormat": "{{compose_service}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Workerログ（$worker）",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "description": "pve-lgtm の Loki に保存された VPS worker (ocms-ubuntu)、VM110 worker (ocms-worker-vm110)、PVE3 worker (ocms-pve3) のログを表示。Worker 変数で切り替える。",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"usbharu-lab\",service_name=\"worker\"} | host_name=~\"$worker\"",
          "legendFormat": "{{host_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12,
      "title": "OCMSログ",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 10
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_namespace=\"usbharu-lab\",service_name=~\"$service\"}",
          "legendFormat": "{{service_name}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "type": "table",
      "title": "遅いリクエストのトレース",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.namespace = \"usbharu-lab\" && duration > 1s }",
          "limit": 30,
          "tableType": "traces"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(Trace ID|traceID)$"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Traceを開く",
                    "url": "/explore?left={%22datasource%22%3A%22${traces}%22%2C%22queries%22%3A%5B{%22refId%22%3A%22A%22%2C%22queryType%22%3A%22traceId%22%2C%22query%22%3A%22${__value.raw}%22}%5D%2C%22range%22%3A{%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22}}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "title": "Worker別 Job累計（選択期間）",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "description": "Loki ログを interval ごとに集計し、選択期間内で累積表示。完了は job_type 別、失敗・retry は status と error_code 別。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host_name, job_type) (count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_completed\" [$__interval]))",
          "legendFormat": "{{host_name}} · {{job_type}} · completed",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (host_name, status, error_code) (count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_failed\" | status=~\"failed|retry\" [$__interval]))",
          "legendFormat": "{{host_name}} · {{status}} · {{error_code}}",
          "range": true,
          "instant": false
        }
      ],
      "transformations": [
        {
          "id": "cumulativeSum",
          "options": {}
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "title": "Worker別 Job数（選択期間）",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 12,
        "y": 58,
        "w": 12,
        "h": 8
      },
      "description": "選択期間の完了・失敗・retry を worker 別に表示。失敗ログには job_type が無いため Error 列で表示。",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host_name, job_type, status) (count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_completed\" | label_format status=\"completed\" [$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "queryType": "instant"
        },
        {
          "refId": "B",
          "expr": "sum by (host_name, status, error_code) (count_over_time({service_namespace=\"usbharu-lab\",service_name=\"worker\"} |= \"media.job_failed\" | status=~\"failed|retry\" [$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "host_name": "Worker",
              "job_type": "Job type",
              "status": "Outcome",
              "error_code": "Error",
              "Value": "Count"
            }
          }
        }
      ]
    },
    {
      "id": 16,
      "title": "VM110 worker ログ",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
