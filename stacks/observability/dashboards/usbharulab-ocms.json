        "w": 24,
        "h": 10
      },
      "description": "VM110 worker の media.job_started / media.pdf_page_completed などを表示",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"worker\"} | host_name=\"ocms-worker-vm110\"",
